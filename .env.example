APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 阿里云 OSS（对齐 guanwang-api）
ALIOSS_ACCESS_ID=
ALIOSS_ACCESS_KEY=
ALIOSS_BUCKET=
ALIOSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIOSS_CDN_DOMAIN=
ALIOSS_SSL=true
ALIOSS_IS_CNAME=true

VITE_APP_NAME="${APP_NAME}"

# Apple Sign In（必须与打包用的 iOS Bundle ID 完全一致，token.aud 就是它）
# 拼写要对：常见误写 yanzehnkun / yanzhenkun
APPLE_CLIENT_ID=top.yanzhenkun.workspace
# 多个用逗号：APPLE_CLIENT_ID=top.yanzehnkun.workspace,top.yanzhenkun.workspace
# APPLE_CLIENT_ID_WEB=

# UniPush 提醒推送（二选一）
# getui：开发者中心 → uni-push → 应用配置
UNIPUSH_DRIVER=getui
UNIPUSH_APP_ID=
UNIPUSH_APP_KEY=
UNIPUSH_MASTER_SECRET=
# 或 unicloud：云函数 URL 化
# UNIPUSH_DRIVER=unicloud
# UNIPUSH_CLOUD_URL=https://xxx.bspapp.com/http/sendPush
# UNIPUSH_CLOUD_SECRET=

# 企业微信群机器人（全局 5xx 告警；客户端统一「服务器开小差了」）
WECOM_WEBHOOK_ENABLED=true
WECOM_WEBHOOK_URL=
WECOM_WEBHOOK_THROTTLE=300
WECOM_WEBHOOK_GLOBAL_THROTTLE=60

# LLM（千问 / OpenAI 兼容；换模型只改这三项）
LLM_DRIVER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 或 DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60

# 语音转写（短音频；可与 LLM 共用 key）
ASR_ENABLED=true
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_API_KEY=
ASR_MODEL=fun-asr-flash
ASR_TIMEOUT=60
